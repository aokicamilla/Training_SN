        <script><![CDATA[var trainingQualifier = Class.create();
trainingQualifier.prototype = {
    initialize: function() {
    },

    uniqueRegistration: function() {
        gs.info("Iniciando o método uniqueRegistration");
        
        var coursesNotToBeShown = [];
        var grRegistration = new GlideRecord('x_1543710_traini_0_registration');
        grRegistration.addEncodedQuery('opened_by=DYNAMIC90d1921e5f510100a9ad2572f2b477fe');
        gs.info("Consulta na tabela x_1543710_traini_0_registration feita");
        grRegistration.query();
        
        while (grRegistration.next()) {
            coursesNotToBeShown.push(grRegistration.agenda.sys_id.toString());
            gs.info("Adicionando agenda.sys_id: " + grRegistration.agenda.sys_id);
        }

        var filteredAgenda = [];
        var grAgenda = new GlideRecord('x_1543710_traini_0_agenda');
        grAgenda.addQuery('state', '2');
        grAgenda.query();
        
        while (grAgenda.next()) {
            gs.info("Verificando agenda: " + grAgenda.sys_id);
            if (coursesNotToBeShown.indexOf(grAgenda.sys_id.toString()) == -1) {
                filteredAgenda.push(grAgenda.sys_id.toString());
                gs.info("Agenda válida adicionada: " + grAgenda.sys_id);
            }
        }

        // Retorna a string com os sys_ids das agendas
        gs.info("Agendas filtradas: " + filteredAgenda.join(','));
        return "sys_idIN" + filteredAgenda.join(',');
    },

    type: 'trainingQualifier'
};
]]></script>
