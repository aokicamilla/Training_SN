        <name>Autopopulate Group</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
    if (isLoading || newValue === '') {
        return;
    }

    // Obter a referência da tabela 'course'
    g_form.getReference('course', function(courseRecord) {
        // Verificar se a referência foi obtida
        if (courseRecord) {
            // Obter o grupo do instrutor a partir do registro de curso
            var instructorGroup = courseRecord.sys_user_group;
            // Popular o campo 'instructor_group' na tabela 'agenda'
            g_form.setValue('instructor_group', instructorGroup);
        }
    });
}]]></script>
