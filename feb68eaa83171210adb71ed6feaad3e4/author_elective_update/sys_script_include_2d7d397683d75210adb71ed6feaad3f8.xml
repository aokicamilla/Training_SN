        <script><![CDATA[var UsersWithInstructorRole = Class.create();
UsersWithInstructorRole.prototype = {
    initialize: function() {
    },

	getInstructorUser : function() 
	{
		var grRole = new GlideRecord ('sys_user_has_role');
		grRole.addEncodedQuery('role.name=x_1543710_traini_0.instructor^state=active');
		grRole.query();

		var instructorUser = [];

		while (grRole.next()) {
			instructorUser.push(grRole.getValue('user'))
		}
		return 'sys_idIN' + instructorUser;
	}
};
