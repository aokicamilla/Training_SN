        <condition/>
        <description/>
        <field>date</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Validate Course</name>
        <order/>
        <script><![CDATA[function onSubmit() {
    // Obter os valores dos campos 'course' e 'date' do formulário
    var course = g_form.getValue('course');  // Substitua 'course' pelo nome real do campo
    var date = g_form.getValue('date');  // Substitua 'date' pelo nome real do campo

    // Criar um GlideAjax para chamar o Script Include
    var ga = new GlideAjax('CheckDuplicateAgenda'); // Nome do Script Include
    ga.addParam('sys_id', 'checkDuplicate'); // Nome do método do Script Include
    ga.addParam('course', course);  // Adiciona 'course' como parâmetro
    ga.addParam('date', date);  // Adiciona 'date' como parâmetro

    // Fazer a chamada assíncrona ao Script Include
    ga.getXMLAnswer(function(response) {
        var answer = response.responseXML.documentElement.getAttribute("answer");
        
        // Verificar se existe um duplicado
        if (answer == 'true') {
            g_form.addErrorMessage('A record with the same Course and Date already exists.');
            return false; // Impede o envio do formulário
        }

        return true; // Permite o envio do formulário
    });
    
    // Impede a submissão até que a verificação assíncrona seja concluída
    return false;
}
]]></script>
