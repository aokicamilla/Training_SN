        <mobile_callable>false</mobile_callable>
        <name>CheckDuplicateAgenda</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var CheckDuplicateAgenda = Class.create();
CheckDuplicateAgenda.prototype = {
    initialize: function() {
    },

    checkDuplicate: function(course, date) {
        var gr = new GlideRecord('x_1543710_traini_0_agenda'); // Tabela de agenda
        gr.addQuery('course', course);  // Filtro para o campo 'course'
        gr.addQuery('date', date);  // Filtro para o campo 'date'
        gr.query();  // Executa a consulta
        
        if (gr.next()) {
            return true;  // Retorna 'true' se encontrar um registro com os mesmos valores
        }
        return false;  // Retorna 'false' se não encontrar duplicados
    },

    type: 'CheckDuplicateAgenda'
};]]></script>
