        <mobile_callable>false</mobile_callable>
        <name>UsersUtils</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var UsersUtils = Class.create();
UsersUtils.prototype = {
    initialize: function() {
    },

    referenceQualifierCourses: function() {
        var coursesNotToBeShown = [];
        var grRegistration = new GlideRecord('x_1543710_traini_0_registration');
        grRegistration.addEncodedQuery('opened_byDYNAMIC90d1921e5f510100a9ad2572f2b477fe');
        grRegistration.query();
        while (grRegistration.next()) {
            coursesNotToBeShown.push(grRegistration.course.sys_id.toString());
        }

        var filteredAgenda = [];
        var grAgenda = new GlideRecord('x_1543710_traini_0_agenda');
        grAgenda.query();
        
        while (grAgenda.next()) {
            // Verificando se o curso da agenda não está na lista de cursos que não devem ser mostrados
            if (coursesNotToBeShown.indexOf(grAgenda.course.sys_id.toString()) == -1) {
                filteredAgenda.push(grAgenda.sys_id.toString());
            }
        }
        // Retorna a string formatada para o Reference Qualifier
        return "sys_idIN" + filteredAgenda.join(',');
    },
	type: 'UsersUtils'
};

]]></script>
