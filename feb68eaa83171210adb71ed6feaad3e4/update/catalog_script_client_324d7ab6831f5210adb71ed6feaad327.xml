        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
   if (isLoading || newValue == '') {
      return;
   }

  	var capacity = g_form.getValue('capacity')
    if (parseFloat(capacity) == 0) {
        g_form.addErrorMessage("This course is full, but not closed yet. You may want to try again later if a spot becomes available.");
        g_form.clearValue("date");          
        g_form.clearValue("course");        
		g_form.clearValue("capacity");
		g_form.clearValue("agenda");
    } else {
        g_form.clearMessages();
    }
   
}]]></script>
